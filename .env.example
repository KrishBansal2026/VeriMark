# VeriMark Environment Variables

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase PostgreSQL Configuration (Optional for cloud, fallback local storage enabled if blank)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Server-Side Ed25519 Keys (Hex encoded 32-byte seeds or keys)
# NEVER expose to client! Generated automatically if omitted in development.
LEDGER_SIGNING_PRIVATE_KEY=your-64-char-hex-ed25519-private-key
APPROVER_1_PRIVATE_KEY=your-64-char-hex-approver1-private-key
APPROVER_2_PRIVATE_KEY=your-64-char-hex-approver2-private-key

# Public Keys (Can be shared for verification)
NEXT_PUBLIC_LEDGER_PUBLIC_KEY=your-64-char-hex-ledger-public-key
NEXT_PUBLIC_APPROVER_1_PUBLIC_KEY=your-64-char-hex-approver1-public-key
NEXT_PUBLIC_APPROVER_2_PUBLIC_KEY=your-64-char-hex-approver2-public-key

# Security & Session Secrets
ADMIN_SECRET_TOKEN=change-this-in-production-to-secure-token
